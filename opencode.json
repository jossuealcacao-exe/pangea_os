{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    "core/00_CONSTITUTION.md",
    "core/05_AUTHORITY_AND_SAFETY.md",
    "agent/INDEX.md"
  ],
  "permission": {
    "read": "allow",
    "edit": "ask",
    "external_directory": "deny",
    "webfetch": "ask",
